# Copy to sync/.env and fill in. sync/.env is git-ignored: never commit it.

# --- Mailbox (read-only IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
# Gmail: an App Password (requires 2-Step Verification). Not your normal password.
IMAP_PASS=
# Safer: a Gmail label fed by a filter (e.g. "Agenda") instead of the whole INBOX.
IMAP_MAILBOX=INBOX

# --- What to sync ---
SYNC_DAYS=7
SYNC_MAX=20
SYNC_BODY_CHARS=1500
SYNC_TZ=America/Mexico_City

# --- Where to upload (sync-and-upload.sh) ---
SANDBOX_NAME=my-assistant
SANDBOX_PROJECT_DIR=/sandbox/.openclaw/workspace/agenda-assistant

# Absolute paths, because cron runs with a minimal PATH. Find them with: which node openshell
NODE_BIN=/usr/bin/node
OPENSHELL_BIN=/usr/local/bin/openshell
